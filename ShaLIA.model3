      <Option value="false" name="default" type="bool"/>
      <Option name="defaultGui" type="invalid"/>
      <Option value="VERY LARGE RASTER GRID" name="description" type="QString"/>
      <Option value="0" name="flags" type="int"/>
      <Option value="If the DTM grid is much larger than the landslide areas within the grid, it must be selected. For example, if the DTM has a resolution of 100x100 meters (area of 10,000 m²) and the landslide areas are much smaller, e.g., 100 or 200 m², the flag must be selected for a more accurate result. If, on the other hand, the DTM has a much lower resolution, e.g., 10x10 meters (area of 100 m²), the flag should not be selected. Choose based on the area data." name="help" type="QString"/>
      <Option name="metadata"/>
      <Option value="very_large_raster_grid" name="name" type="QString"/>
      <Option value="boolean" name="parameter_type" type="QString"/>
    </Option>
