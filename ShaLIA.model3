  <Option name="groupBoxes" type="List">
    <Option type="Map">
      <Option value="0,226,218,255,rgb:0,0.8862745,0.854902,1" name="color" type="QString"/>
      <Option value="SHALIA - SUSCEPTIBILITY MAP - INPUT" name="component_description" type="QString"/>
      <Option value="180" name="component_height" type="double"/>
      <Option value="1080" name="component_pos_x" type="double"/>
      <Option value="120" name="component_pos_y" type="double"/>
